# Optional — required only for private IGN layers (e.g. SCAN 25).
# Plan IGN and orthophotos work without a key on data.geopf.fr.
# Register at https://geoservices.ign.fr/
VITE_IGN_API_KEY=

# Optional — unlocks the OS Maps API (Outdoor style) basemap for Great Britain
# in src/lib/geo/providers/map/gb.ts. Without it, GB falls back to OpenTopoMap.
# Register a free project key at https://osdatahub.os.uk/
VITE_OS_API_KEY=
