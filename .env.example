# Optional — public *client* keys only. Anything in `VITE_*` is baked into the
# static JS bundle and must be treated as extractable (quota / referrer limits).
# Never put server secrets, private API keys, or MLIT Reinfolib keys here.

# Optional — required only for private IGN layers (e.g. SCAN 25).
# Plan IGN and orthophotos work without a key on data.geopf.fr.
# Register at https://geoservices.ign.fr/ and restrict by referrer/app if possible.
VITE_IGN_API_KEY=

# Optional — unlocks the OS Maps API (Outdoor style) basemap for Great Britain
# in src/lib/geo/providers/map/gb.ts. Without it, GB falls back to OpenTopoMap.
# Register a free project key at https://osdatahub.os.uk/
VITE_OS_API_KEY=

# Japan natural-park scan uses static assets (npm run build:jp-ksj) — no API key.
